# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# Supabase project settings (found in your Supabase dashboard → Settings → API)
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-public-key"
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"

# Optional — Cloudflare Turnstile, the bot gate in front of "email me a code".
# Leave it unset and the widget never renders and no token is sent.
# It must be turned on together with Supabase → Authentication → Settings →
# Enable Captcha protection (hCaptcha/Turnstile) and that provider's SECRET key:
# a token with the setting off is ignored, but the setting on with no token
# rejects every sign-in, Google included.
# VITE_TURNSTILE_SITE_KEY="your-turnstile-site-key"
